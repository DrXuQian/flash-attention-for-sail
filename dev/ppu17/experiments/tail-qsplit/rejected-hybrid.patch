diff --git a/hopper/ppu17_tail_qsplit.hpp b/hopper/ppu17_tail_qsplit.hpp
new file mode 100644
--- /dev/null
+++ b/hopper/ppu17_tail_qsplit.hpp
@@ -0,0 +1,130 @@
+#pragma once
+
+#include <cstddef>
+#include <stdexcept>
+#include <type_traits>
+#include "ppu17_tail_qsplit_plan.hpp"
+#include "tile_scheduler.hpp"
+#include "flash_fwd_kernel_sm90.h"
+#include "mainloop_fwd_sm90_tma_gmma_ws.hpp"
+#include "epilogue_fwd.hpp"
+
+namespace flash {
+
+// Same real divmod/coordinate implementation as the prefix, but each tail
+// worker owns exactly one half. No atomic queue or cross-CTA synchronization.
+struct Ppu17TailHalfScheduler : StaticPersistentTileScheduler<false> {
+    using Base = StaticPersistentTileScheduler<false>;
+    using Base::Base;
+    template<bool IsProducerWarp = false>
+    CUTLASS_DEVICE WorkTileInfo get_initial_work(Params const&) const {
+        return {Ppu17TailQSplitPlan::HalfStart + int(blockIdx.x)};
+    }
+    template<bool IsProducerWarp = false>
+    CUTLASS_DEVICE WorkTileInfo get_next_work(Params const& p, WorkTileInfo const&) const {
+        return {p.total_blocks};
+    }
+};
+
+template<class FullMainloop, class FullEpilogue, class Scheduler>
+struct Ppu17TailQSplitKernel {
+    using Plan = Ppu17TailQSplitPlan;
+    using ClusterShape = cute::Shape<cute::_1, cute::_1, cute::_1>;
+    using FullShape = cute::Shape<cute::_128, cute::_128, cute::_128>;
+    using HalfShape = cute::Shape<cute::_64, cute::_128, cute::_128>;
+    template<class Shape>
+    using Mainloop = CollectiveMainloopFwdSm90<2, ClusterShape, Shape, 128,
+        cutlass::half_t, float, cutlass::arch::Sm90,
+        false, false, false, false, false, false, false, true, true, false, false, false>;
+    using HalfMainloop = Mainloop<HalfShape>;
+    using HalfEpilogue = CollectiveEpilogueFwd<HalfShape, ClusterShape,
+        cutlass::half_t, cutlass::arch::Sm90, HalfMainloop::NumMmaThreads,
+        false, false, false, false>;
+    using ExpectedEpilogue = CollectiveEpilogueFwd<FullShape, ClusterShape,
+        cutlass::half_t, cutlass::arch::Sm90, FullMainloop::NumMmaThreads,
+        false, false, false, false>;
+    static_assert(std::is_same_v<FullMainloop, Mainloop<FullShape>>,
+                  "tail experiment requires the exact C07 collective");
+    static_assert(std::is_same_v<FullEpilogue, ExpectedEpilogue>);
+    static_assert(std::is_same_v<Scheduler, StaticPersistentTileScheduler<false>>);
+    using FullKernel = FlashAttnFwdSm90<FullMainloop, FullEpilogue, Scheduler>;
+    using HalfKernel = FlashAttnFwdSm90<HalfMainloop, HalfEpilogue, Ppu17TailHalfScheduler>;
+    using ArchTag = typename FullKernel::ArchTag;
+    static constexpr int MaxThreadsPerBlock = FullKernel::MaxThreadsPerBlock;
+    static constexpr int MinBlocksPerMultiprocessor = FullKernel::MinBlocksPerMultiprocessor;
+    static constexpr int SharedStorageSize = FullKernel::SharedStorageSize;
+    static constexpr int FullQueryEmptyCount = FullMainloop::NumMmaThreadsQK +
+                                               FullMainloop::NumProducerThreads;
+    static_assert(FullQueryEmptyCount == 288 && FullMainloop::NumProducerThreads == 32);
+    static_assert(MaxThreadsPerBlock == 384 && HalfKernel::MaxThreadsPerBlock == 256);
+    // The half pipeline is initialized in retired tensor storage, NOT over a
+    // previously initialized mbarrier. Both the old pipeline and TMA stores
+    // have drained before this region is reused.
+    static_assert(HalfKernel::SharedStorageSize <=
+                  offsetof(typename FullKernel::SharedStorage, pipelines),
+                  "half storage overlaps the old pipeline barriers");
+    static_assert(FullKernel::LoadRegisterRequirement == 24 &&
+                  FullKernel::MmaRegisterRequirement == 240 &&
+                  HalfKernel::LoadRegisterRequirement == 56 &&
+                  HalfKernel::MmaRegisterRequirement == 256);
+
+    struct Arguments {
+        typename FullKernel::Arguments full;
+        typename HalfKernel::Arguments half;
+    };
+    struct Params {
+        typename FullKernel::Params full;
+        typename HalfKernel::Params half;
+    };
+    static Params to_underlying_arguments(Arguments const& args) {
+        const auto& a = args.full;
+        if (!Plan::admits(cute::get<3>(a.mainloop.shape_Q),
+                         cute::get<0>(a.mainloop.shape_Q), cute::get<0>(a.mainloop.shape_K),
+                         cute::get<2>(a.mainloop.shape_Q), cute::get<2>(a.mainloop.shape_K),
+                         cute::get<1>(a.mainloop.shape_Q), a.mainloop.headdim_v,
+                         a.hw_info.sm_count) || a.scheduler.num_splits != 1 ||
+            a.scheduler.num_blocks != Plan::FullBlocksPerHead ||
+            args.half.scheduler.num_blocks != Plan::HalfBlocksPerHead) {
+            throw std::invalid_argument("tail Q split only admits B1/S1024/H56/D128/40SM");
+        }
+        Params p{FullKernel::to_underlying_arguments(a),
+                 HalfKernel::to_underlying_arguments(args.half)};
+        if (p.full.scheduler.total_blocks != Plan::TotalFull ||
+            p.half.scheduler.total_blocks != Plan::HalfEnd)
+            throw std::invalid_argument("tail Q split scheduler denominator mismatch");
+        p.full.scheduler.total_blocks = Plan::Prefix;
+        return p;
+    }
+    static dim3 get_grid_shape(Params const& p) { return FullKernel::get_grid_shape(p.full); }
+    static dim3 get_block_shape() { return FullKernel::get_block_shape(); }
+
+    CUTLASS_DEVICE void operator()(Params const& p, char* storage) {
+        FullKernel{}(p.full, storage);
+        // mma() releases Q for a possible NEXT tile even on its final tile.
+        // load_tail() drains TMA/O, but does not consume that final release.
+        // Complete the old 256-consumer +32-producer barrier phase BEFORE
+        // changing QueryEmpty's expected count to128+32 for the M64 path.
+        if (threadIdx.x < FullMainloop::NumProducerThreads) {
+            cutlass::arch::NamedBarrier::sync(FullQueryEmptyCount,
+                static_cast<uint32_t>(FwdNamedBarriers::QueryEmpty));
+        }
+        // FullKernel returns only after load_tail and epilogue.store_tail.
+        // Its unused producer warps return HERE, not out of this CTA. This
+        // full-CTA join makes retired tensor storage reusable locally.
+        __syncthreads();
+        if (int(blockIdx.x) >= Plan::TailHalves) return;
+        if (threadIdx.x >= HalfKernel::MaxThreadsPerBlock) {
+            cutlass::arch::warpgroup_reg_dealloc<24>();
+            return;
+        }
+        if (threadIdx.x < 128) {
+            // Full producer ended at24. Restore an initialization budget
+            // before the half collective redistributes it to56/256. The
+            // retired second math WG relinquishes240->24 first as needed.
+            cutlass::arch::warpgroup_reg_alloc<168>();
+        }
+        HalfKernel{}.template operator()<HalfKernel::MaxThreadsPerBlock>(p.half, storage);
+    }
+};
+
+} // namespace flash
diff --git a/hopper/ppu17_tail_qsplit_plan.hpp b/hopper/ppu17_tail_qsplit_plan.hpp
new file mode 100644
--- /dev/null
+++ b/hopper/ppu17_tail_qsplit_plan.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+namespace flash {
+
+// Bounded noncausal experiment, NOT a general scheduler/selector. The whole
+// prefix retains the existing static scheduler and K order. Only the final
+// head's eight M128 tiles become sixteen disjoint M64 tiles.
+struct Ppu17TailQSplitPlan {
+    static constexpr int Grid = 40;
+    static constexpr int Heads = 56;
+    static constexpr int Sequence = 1024;
+    static constexpr int Dim = 128;
+    static constexpr int FullM = 128;
+    static constexpr int HalfM = 64;
+    static constexpr int FullBlocksPerHead = Sequence / FullM;
+    static constexpr int HalfBlocksPerHead = Sequence / HalfM;
+    static constexpr int TotalFull = Heads * FullBlocksPerHead;
+    static constexpr int Prefix = TotalFull / Grid * Grid;
+    static constexpr int TailHalves = (TotalFull - Prefix) * 2;
+    static constexpr int HalfStart = Prefix * 2;
+    static constexpr int HalfEnd = TotalFull * 2;
+    static_assert(Prefix == 440 && TailHalves == 16);
+    static_assert(Prefix % FullBlocksPerHead == 0);
+    static_assert(TailHalves <= Grid);
+
+    static constexpr bool admits(int batch, int q, int k, int heads,
+                                 int kv_heads, int dim, int dv, int sms) {
+        return batch == 1 && q == Sequence && k == Sequence && heads == Heads &&
+               kv_heads == Heads && dim == Dim && dv == Dim && sms == Grid;
+    }
+};
+
+} // namespace flash
