+// Compile-only negative control; never launched or linked into the application.
+#include "ownership.cu"
+#if defined(PLANT_INIT_THREADS)
+__global__ void init_cohort_probe(Hybrid::HalfKernel::Params p) {
+    extern __shared__ char storage[];
+    Hybrid::HalfKernel{}.template operator()<PLANT_INIT_THREADS>(p, storage);
+}
